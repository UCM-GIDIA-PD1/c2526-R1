from sklearn.compose import ColumnTransformer
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.preprocessing import OneHotEncoder, StandardScaler
from sklearn.pipeline import Pipeline
from sklearn.neighbors import KNeighborsClassifier
from Server_PD import download_dataframe_minio
import json

def entramiento_modelo_knn_generos(): 

    preprocess = ColumnTransformer(
    transformers=[
        ("titulo", TfidfVectorizer(max_features=2000), "Titulo"),
        ("descripcion", TfidfVectorizer(max_features=4000), "Descripcion"),
        ("tags", TfidfVectorizer(max_features=2000), "Tags"),
        ("edad", OneHotEncoder(), ["rango_edad"]),
        ("duracion", StandardScaler(), ["duracion"])
    ]
    )
    pipeline = Pipeline([
    ("preprocess", preprocess),
    ("model", KNeighborsClassifier(n_neighbors=5))
    ])
    with open("src/Private/claves.json", "r", encoding="utf-8") as archivo:
        claves = json.load(archivo)
    df_train = download_dataframe_minio("pd1", "grupo1/modelos/train_no_filters", claves, "parquet")
    df_test = download_dataframe_minio("pd1", "grupo1/modelos/test_no_filters", claves, "parquet")
    X_train = df_train.drop(columns=["Generos"])
    y_train = df_train["Generos"]
    X_test = df_test.drop(columns=["Generos"])
    y_test = df_test["Generos"]

    pipeline.fit(X_test, y_test)
    pred = pipeline.predict(X_test)
